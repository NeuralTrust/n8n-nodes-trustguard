    {
      "parameters": {
        "jsCode": "// Output 4 \u2014 the error output.\n// Expect: \"TrustGuard guardrail service unreachable\".\n// Nothing reaches Allow. Nothing proceeded unevaluated.\nreturn $input.all().map(i => ({\n  json: {\n    branch: 'fail-closed',\n    outcome: 'stopped \u2014 item routed to the error output',\n    error: i.json.error,\n  },\n}));"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        680,
        -220
      ],
      "id": "ee584fe3-0449-51cd-8c26-3c3a727bd148",
      "name": "Captured Error"
    },
    {
      "parameters": {
        "operation": "evaluateInput",
        "inputMode": "text",
        "text": "={{ $json.prompt }}",
        "options": {
          "protocol": "llm",
          "timeout": 3,
          "failOpenOnUnreachable": true
        }
      },
      "type": "@neuraltrust/n8n-nodes-trustguard.neuralTrustTrustGuard",
      "typeVersion": 1,
      "position": [
        340,
        20
      ],
      "id": "2b2ddb84-fa87-56e9-b146-d3b9a1c1d4be",
      "name": "Fail Open on Unreachable",
      "credentials": {
        "trustGuardApi": {
          "name": "NeuralTrust TrustGuard (unreachable)"
        }
      },
      "notes": "failOpenOnUnreachable = true",
      "notesInFlow": true
    },
    {
      "parameters": {
        "jsCode": "// Fail-open puts the item on ALLOW with a marker.\n// trustguard.unreachable === true means \"nobody checked this\".\n// Alert on it. Do not treat it as a clean allow.\nreturn $input.all().map(i => ({\n  json: {\n    branch: 'fail-open',\n    outcome: 'continued on Allow WITHOUT evaluation',\n    status: i.json.trustguard?.status,\n    unreachable: i.json.trustguard?.unreachable,\n    error: i.json.trustguard?.error,\n    trace_id: i.json.trustguard?.trace_id ?? null,\n    warning: 'Traffic proceeded unevaluated. This is the trade-off you opted into.',\n  },\n}));"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        680,
        -40
      ],
      "id": "286c7dd3-3d82-58af-bb54-3b251b7e1ab0",
      "name": "Continued Unevaluated"
    },
